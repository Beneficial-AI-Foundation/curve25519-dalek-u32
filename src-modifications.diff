+        #[doc(hidden)]
+        pub mod fiat_u32;
+
+        #[cfg(curve25519_dalek_bits = "64")]
+        #[doc(hidden)]
+        pub mod fiat_u64;
+
+    } else {
+
+        #[cfg(curve25519_dalek_bits = "32")]
+        #[doc(hidden)]
+        pub mod u32;
+
+        #[cfg(curve25519_dalek_bits = "64")]
+        #[doc(hidden)]
+        pub mod u64;
+
+    }
+}
